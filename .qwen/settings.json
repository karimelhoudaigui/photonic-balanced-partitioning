{
  "$version": 4,
  "security": {
    "auth": {
      "selectedType": "openai"
    }
  },
  "model": {
    "name": "pasqal-qwen-research:latest",
    "maxSessionTurns": 12,
    "maxWallTimeSeconds": 300,
    "maxToolCalls": 12,
    "maxSubagentDepth": 1
  },
  "modelProviders": {
    "openai": [
      {
        "id": "pasqal-qwen-research:latest",
        "name": "Local Qwen3.5 2B Q4 (Ollama)",
        "envKey": "PASQAL_OLLAMA_API_KEY",
        "baseUrl": "http://127.0.0.1:11435/v1",
        "generationConfig": {
          "contextWindowSize": 32768,
          "timeout": 180000,
          "maxRetries": 0,
          "samplingParams": {
            "temperature": 0.2,
            "max_tokens": 1536,
            "reasoning_effort": "none"
          },
          "extra_body": {
            "reasoning_effort": "none"
          }
        }
      }
    ]
  },
  "experimental": {
    "agentTeam": true,
    "emitToolUseSummaries": false
  },
  "agents": {
    "defaultBackground": false,
    "crossSessionMessaging": false
  },
  "telemetry": {
    "enabled": false
  },
  "permissions": {
    "allow": [
      "Read",
      "Write(reports/**)",
      "Write(results/**)",
      "Write(experiments/**)",
      "Shell(python*)",
      "Shell(.venv/bin/python*)"
    ],
    "deny": [
      "Edit(paper/**)",
      "Write(paper/**)",
      "Shell(*qpu/run_qpu*)",
      "Shell(*qpu/smoke_test*)",
      "web_fetch",
      "web_search"
    ]
  },
  "memory": {
    "enableManagedAutoMemory": false,
    "enableManagedAutoDream": false,
    "enableAutoSkill": false,
    "enableTeamMemory": false,
    "enableTeamMemorySync": false,
    "enableStructuredRecall": false
  },
  "tools": {
    "workflowNameOnly": true,
    "visible": [
      "mcp__research__run_density_primary",
      "mcp__research__run_density_replication",
      "mcp__research__audit_density_primary",
      "mcp__research__audit_density_pair",
      "mcp__research__health"
    ]
  },
  "mcpServers": {
    "research": {
      "command": "/usr/bin/python3",
      "args": [
        "scripts/research_actions_mcp.py"
      ],
      "cwd": ".",
      "timeout": 360000,
      "trust": true,
      "env": {
        "PASQAL_PYTHON": "${PASQAL_PYTHON}",
        "PYTHONPATH": "src",
        "PYTHONDONTWRITEBYTECODE": "1",
        "OMP_NUM_THREADS": "1",
        "OPENBLAS_NUM_THREADS": "1"
      }
    }
  },
  "mcp": {
    "allowed": [
      "research"
    ]
  }
}
