{
  "$version": 4,
  "security": {
    "auth": {
      "selectedType": "openai"
    }
  },
  "model": {
    "name": "pasqal-qwen-research:latest",
    "maxSessionTurns": 12,
    "maxWallTimeSeconds": 300,
    "maxToolCalls": 12,
    "maxSubagentDepth": 1
  },
  "modelProviders": {
    "openai": [
      {
        "id": "pasqal-qwen-research:latest",
        "name": "Local Qwen3.5 2B Q4 (Ollama)",
        "envKey": "PASQAL_OLLAMA_API_KEY",
        "baseUrl": "http://127.0.0.1:11435/v1",
        "generationConfig": {
          "contextWindowSize": 32768,
          "timeout": 180000,
          "maxRetries": 0,
          "samplingParams": {
            "temperature": 0.2,
            "max_tokens": 1536,
            "reasoning_effort": "none"
          },
          "extra_body": {
            "reasoning_effort": "none"
          }
        }
      }
    ]
  },
  "experimental": {
    "agentTeam": true,
    "emitToolUseSummaries": false
  },
  "agents": {
    "defaultBackground": false,
    "crossSessionMessaging": false
  },
  "telemetry": {
    "enabled": false
  },
  "permissions": {
    "allow": [
      "Read",
      "Write(reports/**)",
      "Write(results/**)",
      "Write(experiments/**)",
      "Shell(python*)",
      "Shell(.venv/bin/python*)"
    ],
    "deny": [
      "Edit(paper/**)",
      "Write(paper/**)",
      "Shell(*qpu/run_qpu*)",
      "Shell(*qpu/smoke_test*)",
      "web_fetch",
      "web_search"
    ]
  },
  "memory": {
    "enableManagedAutoMemory": false,
    "enableManagedAutoDream": false,
    "enableAutoSkill": false,
    "enableTeamMemory": false,
    "enableTeamMemorySync": false,
    "enableStructuredRecall": false
  }
}
